    "test": "vitest run",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
