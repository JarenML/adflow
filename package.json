{
  "name": "adflow",
  "productName": "AdFlow",
  "version": "0.1.0",
  "description": "Desktop studio that turns a video playbook into a visual, batch-capable production pipeline.",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
